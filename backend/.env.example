PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/collective_lecture
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# Core AI retrieval and insight pipeline
AI_ENABLED=false

# Local Transformers generation is enabled by default when AI_ENABLED=true.
# Set to false to force evidence-grounded fallback answers.
LLM_ENABLED=
LLM_PROVIDER=

# Optional OpenAI-compatible cloud LLM.
# Works with OpenAI, Azure OpenAI gateways, Groq, Together, OpenRouter, etc.
CLOUD_LLM_API_KEY=
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
CLOUD_LLM_MODEL=gpt-4o-mini
CLOUD_LLM_TIMEOUT_MS=30000
CLOUD_LLM_MAX_TOKENS=
CLOUD_LLM_TEMPERATURE=

# Local model caching
HF_CACHE_DIR=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=